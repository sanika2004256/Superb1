{
  "redirects": [
    {
      "source": "/admin/login",
      "destination": "/login",
      "permanent": false
    },
    {
      "source": "/admin/login/(.*)",
      "destination": "/login",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}